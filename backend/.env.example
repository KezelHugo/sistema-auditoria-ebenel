PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL (Supabase Session Pooler IPv4 o Neon)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Seguridad JWT (generar una cadena larga aleatoria en producción)
JWT_SECRET=cambia-esta-clave-secreta-ebenel-2026
JWT_EXPIRES_IN=12h

# Conexión hacia el ERP simulado (simulador-erp-ebenel)
ERP_API_BASE_URL=https://simulador-erp-ebenel.onrender.com
ERP_API_KEY=

# CORS (URL del frontend en Vercel/Render separada por comas o *)
CORS_ORIGIN=http://localhost:5173

# Credenciales semilla iniciales (solo se crean si la tabla usuarios está vacía)
SEED_GERENCIA_EMAIL=gerencia@ebenel.com.pe
SEED_GERENCIA_PASSWORD=Ebenel2026!
SEED_EMPLEADO_EMAIL=logistica@ebenel.com.pe
SEED_EMPLEADO_PASSWORD=Ebenel2026!
